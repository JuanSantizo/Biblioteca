{
  "name": "library-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Technical foundation for the library REST API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "check": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "mssql": "^11.0.1",
    "pino": "^9.9.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
